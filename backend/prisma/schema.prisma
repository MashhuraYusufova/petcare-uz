datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  password  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
  orders    Order[]
  appointments Appointment[]
  wishlist  WishlistItem[]
}

model Pet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  species   String
  breed     String
  age       String
  weight    String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String   @db.ObjectId
}

model Vet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  spec      String
  clinic    String
  district  String
  rating    Float
  reviews   Int
  exp       String
  price     String
  avail     Boolean
  slots     String[]
  email     String?  @unique
  appointments Appointment[]
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  price     Int
  oldPrice  Int?
  rating    Float
  reviews   Int
  tag       String?
  img       String
  brand     String
  cat       String
  stock     Int      @default(0)
}

model Article {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  cat       String
  read      String
  date      String
  author    String
  excerpt   String?
}

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  item      String
  date      String
  status    String
  price     String
  img       String
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Appointment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      String
  status    String
  reason    String?
  vet       Vet      @relation(fields: [vetId], references: [id])
  vetId     String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
}
